  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = mbed-os/connectivity/nanostack/coap-service/CMakeFiles/mbed-nanostack-coap_service.dir/mbed-nanostack-coap_service.pdb
  TARGET_FILE = mbed-os/connectivity/nanostack/coap-service/libmbed-nanostack-coap_service.a
