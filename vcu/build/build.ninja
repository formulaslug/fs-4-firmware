  OBJECT_DIR = mbed-os/connectivity/nanostack/CMakeFiles/mbed-nanostack.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = mbed-os/connectivity/nanostack/CMakeFiles/mbed-nanostack.dir/mbed-nanostack.pdb
