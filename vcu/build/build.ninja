build mbed-os/connectivity/nanostack/coap-service/libmbed-nanostack-coap_service.a: CXX_STATIC_LIBRARY_LINKER__mbed-nanostack-coap_service_Develop mbed-os/connectivity/nanostack/coap-service/CMakeFiles/mbed-nanostack-coap_service.dir/source/coap_connection_handler.c.obj mbed-os/connectivity/nanostack/coap-service/CMakeFiles/mbed-nanostack-coap_service.dir/source/coap_message_handler.c.obj mbed-os/connectivity/nanostack/coap-service/CMakeFiles/mbed-nanostack-coap_service.dir/source/coap_security_handler.c.obj mbed-os/connectivity/nanostack/coap-service/CMakeFiles/mbed-nanostack-coap_service.dir/source/coap_service_api.c.obj || mbed-os/connectivity/nanostack/sal-stack-nanostack/libmbed-nanostack-sal_stack.a
