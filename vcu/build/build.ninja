build mbed-os/drivers/device_key/libmbed-device_key.a: CXX_STATIC_LIBRARY_LINKER__mbed-device_key_Develop mbed-os/drivers/device_key/CMakeFiles/mbed-device_key.dir/source/DeviceKey.cpp.obj || mbed-os/connectivity/mbedtls/libmbed-mbedtls.a mbed-os/storage/blockdevice/TARGET_FLASH/libmbed-storage-flashiap.a mbed-os/storage/blockdevice/libmbed-storage-blockdevice.a mbed-os/storage/filesystem/fat/libmbed-storage-fat.a mbed-os/storage/filesystem/libmbed-storage-filesystem.a mbed-os/storage/filesystem/littlefs/libmbed-storage-littlefs.a mbed-os/storage/filesystem/littlefsv2/libmbed-storage-littlefs-v2.a
  CONFIG = Develop
  LANGUAGE_COMPILE_FLAGS = -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -Wno-psabi -Wno-packed-bitfield-compat -fmessage-length=0 -fno-exceptions -ffunction-sections -fdata-sections -funsigned-char -fomit-frame-pointer -g3 -mthumb -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=softfp -Wno-register
  OBJECT_DIR = mbed-os/drivers/device_key/CMakeFiles/mbed-device_key.dir
  POST_BUILD = :
  PRE_LINK = :
