  LANGUAGE_COMPILE_FLAGS = -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers -Wno-psabi -Wno-packed-bitfield-compat -fmessage-length=0 -fno-exceptions -ffunction-sections -fdata-sections -funsigned-char -fomit-frame-pointer -g3 -mthumb -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=softfp -Wno-register
  OBJECT_DIR = mbed-os/storage/kvstore/kv_config/CMakeFiles/mbed-storage-kv-config.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = mbed-os/storage/kvstore/kv_config/CMakeFiles/mbed-storage-kv-config.dir/mbed-storage-kv-config.pdb
