{
  // This target clones the existing NUCLEO_L452RE_P target without making
  // any changes other than an extra define.
  "STM32_TEST_BOARD_V1": {
    // Which MBED target to base this off of
    "inherits": ["MCU_STM32G441xB"],

    // Maps from a target in Mbed OS to a device in a CMSIS Pack - helps some IDEs
    // Targets STM32G431 because STM32G441 is not in mbed-os/targets/cmsis_mcu_descrpitions.json5
    "device_name": "STM32G431KBTx", 
  
    "overrides": {
      "stdio_uart_tx": "PA_2",
      "stdio_uart_rx": "PA_3",
      "clock_source": "USE_PLL_HSE_XTAL",
      "lse_available": 0,
      "hse_value": 24000000,
      //"sysclock": 160000000,
    },
  },

  // Config for peripheral board
  "PERIPHERAL_BOARD": {
    "inherits": [
        "MCU_STM32G441xB"
    ],

    "device_name": "STM32G431KBTx",

    "overrides": {
      "stdio_uart_tx": "PA_2",
      "stdio_uart_rx": "PA_3",
      "clock_source": "USE_PLL_HSE_XTAL",
      "lse_available": 0,
      "hse_value": 24000000,
    },
  },

  // Config for tractive battery
  "TRACTIVE_BATTERY_BOARD": {
    "inherits": [
        "MCU_STM32G441xB"
    ],
    "device_name": "STM32G431KBTx",

    "overrides": {
      "stdio_uart_tx": "PA_2",  
      "stdio_uart_rx": "PA_3",
      "clock_source": "USE_PLL_HSE_XTAL",
      "lse_available": 0,
      "hse_value": 24000000,
    },
  },
  
  // Config for tractive battery f4, based off STM32F446
  "TRACTIVE_BATTERY_BOARD_F4": {
    "inherits": [
        "MCU_STM32F446xE"
    ],  

    "device_name": "STM32F446RETx",

    "overrides": {
      "stdio_uart_tx": "PB_6",
      "stdio_uart_rx": "PB_7",
      "clock_source": "USE_PLL_HSE_XTAL",
      "lse_available": 0,
    },
  },

  // Config for steering dash, based off STM32G473
  "STEERING_DASH_BOARD": {
    "inherits": [
        "MCU_STM32G473xE"
    ],  
    // Targets STM32G474 because STM32G473 is not in mbed-os/targets/cmsis_mcu_descrpitions.json5
    "device_name": "STM32G474RETx",

    "overrides": {
      "stdio_uart_tx": "PA_6",
      "stdio_uart_rx": "PA_7",
      "clock_source": "USE_PLL_HSE_XTAL",
      "lse_available": 0,
      "hse_value": 24000000,
    },
  },
  
  // Config for steering dash, based off STM32F446
  "STEERING_DASH_BOARD_F4": {
    "inherits": [
        "MCU_STM32F446xE"
    ],  

    "device_name": "STM32F446RETx",

    "overrides": {
      "stdio_uart_tx": "PA_9",
      "stdio_uart_rx": "PA_10",
      "clock_source": "USE_PLL_HSE_XTAL",
      "lse_available": 0,
      // "hse_value": 24000000, // no hse parameter
    },
  },
  
  // Config for vehicle control f4, based off STM32F446
  "VEHICLE_CONTROL_BOARD_F4": {
    "inherits": [
        "MCU_STM32F446xE"
    ],  

    "device_name": "STM32F446RETx",

    "overrides": {
      "stdio_uart_tx": "PB_6",
      "stdio_uart_rx": "PB_7",
      "clock_source": "USE_PLL_HSE_XTAL",
      "lse_available": 0,
    },
  },

  // Other targets will go here!

  //{
  //    "BLUEPILL_F103C8": {
