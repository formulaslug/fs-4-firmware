  //        },
  //        "device_has_remove": [
  //            "STDIO_MESSAGES"
  //        ],
  //        "device_name": "STM32F103C8"
  //    }
  //}

  // hse_value defined as a config bc STM32F446xE in targets.json has no HSE config
  //"config": {
  //  "hse_value": {
  //      "help": "HSE default value is 8MHz in stm32f4xx_hal_conf.h",
  //      "value": "24000000",
  //      "macro_name": "HSE_VALUE"
  //  }
  //},
}

