{
  // This target clones the existing NUCLEO_L452RE_P target without making
  // any changes other than an extra define.
  "STM32_TEST_BOARD_V1": {
    // Which MBED target to base this off of
    "inherits": ["MCU_STM32G441xB"],

    // Maps from a target in Mbed OS to a device in a CMSIS Pack - helps some IDEs
    "device_name": "STM32G441KBTx",
  
    "overrides": {
      "stdio_uart_tx": "PA_2",
      "stdio_uart_rx": "PA_3",
      "clock_source": "USE_PLL_HSE_XTAL",
      "lse_available": 0,
      "hse_value": 24000000,
      //"sysclock": 160000000,
    },
  },

  // Config for peripheral board
  "peripheral-board": {
    "inherits": [
        "MCU_STM32G441xB"
    ],
    "device_name": "STM32G441KBTx",

    "overrides": {
      "stdio_uart_tx": "PA_2",
      "stdio_uart_rx": "PA_3",
      "clock_source": "USE_PLL_HSE_XTAL",
      "lse_available": 0,
      "hse_value": 24000000,
    },
  },

  // Config for tractive battery
  "tractive-battery-board": {
    "inherits": [
        "MCU_STM32G441xB"
    ],
    "device_name": "STM32G441KBTx",

    "overrides": {
      "stdio_uart_tx": "PA_2",
      "stdio_uart_rx": "PA_3",
      "clock_source": "USE_PLL_HSE_XTAL",
      "lse_available": 0,
      "hse_value": 24000000,
    },
  },

  // Config for steering dash, based off STM32G473RTC
  "tractive-battery-board": {
    "inherits": [
        "MCU_STM32G473xE"
    ],
    "device_name": "STM32G441KBTx",

    "overrides": {
      "stdio_uart_tx": "PA_2",
      "stdio_uart_rx": "PA_3",
      "clock_source": "USE_PLL_HSE_XTAL",
      "lse_available": 0,
      "hse_value": 24000000,
    },
  },

  // Other targets will go here!

  //{
  //    "BLUEPILL_F103C8": {
  //        "inherits": [
  //            "MCU_STM32F103x8"
  //        ],
